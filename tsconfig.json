{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "compileOnSave": true,
  "include": [
    "src",
    "../shared"
  ],
  "exclude": [
    "node_modules",
    "../node_modules",
    "../src",
    "**/__tests__/**",
    "**/*.test.ts",
    "../shared/**/__tests__/**",
    "../shared/**/*.test.ts"
  ]
}
